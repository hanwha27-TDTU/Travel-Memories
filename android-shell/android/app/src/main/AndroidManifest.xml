<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- 🔴 LAUNCHER는 MainActivity가 아니라 아래 activity-alias들이 가진다(아이콘 전환).
                 전환할 때 alias만 켜고 끄면 되고, MainActivity(딥링크·singleTask)는 건드리지
                 않는다. 그래서 이 activity에는 MAIN/LAUNCHER intent-filter가 **없다.** -->

            <!-- 구글 로그인 복귀 딥링크(ADR-0037). 셸에서 OAuth는 시스템 브라우저로 나가는데
                 (구글이 WebView 로그인을 거부), 복귀가 웹 URL이면 세션이 브라우저에 생기고
                 사용자는 위치가 지워지는 옛 경로에 남는다(실측 2026-08-01 12:52).
                 이 스킴으로 Supabase가 되돌려 보내면 안드로이드가 셸을 다시 연다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.bugeon.journey" />
            </intent-filter>

        </activity>

        <!-- ── 아이콘 전환 (ADR-0038) ──────────────────────────────────────────
             각 아이콘 = 하나의 activity-alias. **정확히 하나만 enabled**. 기본은 여권(IconPassport).
             IconSwitcherPlugin(네이티브)이 setComponentEnabledSetting으로 켜고 끈다.
             alias 이름은 플러그인이 참조하므로 바꾸지 않는다(app.bugeon.journey.IconXxx).
             웹/PWA에는 없는 기능 — 설치 시 아이콘이 고정되기 때문(셸 전용). -->
        <activity-alias android:name=".IconPassport" android:enabled="true" android:exported="true"
            android:targetActivity=".MainActivity" android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconCompass" android:enabled="false" android:exported="true"
            android:targetActivity=".MainActivity" android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_compass" android:roundIcon="@mipmap/ic_launcher_compass_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconGlobe" android:enabled="false" android:exported="true"
            android:targetActivity=".MainActivity" android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_globe" android:roundIcon="@mipmap/ic_launcher_globe_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconSuitcase" android:enabled="false" android:exported="true"
            android:targetActivity=".MainActivity" android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_suitcase" android:roundIcon="@mipmap/ic_launcher_suitcase_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconMountain" android:enabled="false" android:exported="true"
            android:targetActivity=".MainActivity" android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_mountain" android:roundIcon="@mipmap/ic_launcher_mountain_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 🔴 이 앱의 존재 이유(ADR-0036): 크롬이 요청하지 않는 이 권한 때문에 PWA는 위치가
         지워진 사진만 받았다. setRequireOriginal은 이 권한 없이는 예외를 던진다. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- getMediaUri로 바꾼 MediaStore URI는 SAF 부여 밖이라 미디어 읽기 권한이 따로 필요하다. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 안드로이드 14 「일부 사진만 허용」 — 이걸 선언 안 하면 부분 허용이 곧 거부가 된다. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- 📍 내 위치 — WebView의 geolocation 요청을 Capacitor 브리지가 앱 권한으로 잇는다. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
