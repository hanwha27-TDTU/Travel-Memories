{
  "name": "journey-archive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "개인 여행기록 앱 (Bugeon Journey)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/gen-version-file.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "harness": "node scripts/harness.mjs",
    "live": "node scripts/verify-editor-live.mjs && node scripts/verify-diagnostics-live.mjs",
    "brief": "node scripts/brief.mjs",
    "compare:geocoders": "node scripts/compare-geocoders.mjs",
    "check:secrets": "node scripts/check-secret-leak.mjs",
    "gates": "node scripts/harness.mjs --fast",
    "release:arm": "node scripts/release-lock.mjs arm",
    "release:reopen": "node scripts/release-lock.mjs reopen",
    "release:close": "node scripts/release-lock.mjs close",
    "release:status": "node scripts/release-lock.mjs status",
    "gen:adapters": "node scripts/gen-adapters.mjs",
    "gen:harness-law": "node scripts/gen-harness-law.mjs",
    "gen:sync-release": "node scripts/gen-sync-release-contract.mjs",
    "verify:sync-release-live": "node scripts/verify-sync-release-live.mjs",
    "known": "node scripts/known.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dexie": "^4.0.8",
    "maplibre-gl": "^4.5.0",
    "mediabunny": "1.53.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "playwright": "1.56.1",
    "typescript": "^5.5.4",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
