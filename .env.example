# Bugeon Journey · 환경변수 예시 (실제 .env는 커밋 금지)
# 브라우저 번들에는 publishable 키만 넣는다. service_role/secret 키는 절대 금지(SECURITY.md).

# 실제 값(ADR-0020 공유 프로젝트 Travel&Accounting — publishable 키는 공개 안전):
VITE_SUPABASE_URL=https://ihxiywffzmvrwmqvatzt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_odSJPQq5HtylGyJEp-x95g_LL9wlcxR

# 한국 지도 표시용 Kakao JavaScript 키(브라우저용 공개 식별자, REST 키와 다름).
VITE_KAKAO_JAVASCRIPT_KEY=

# 우즈베키스탄·카자흐스탄·키르기스스탄 지도 표시용 TomTom 브라우저 API 키.
# TomTom 개발자 콘솔에서 허용 도메인과 Map Display API만 제한한다.
VITE_TOMTOM_API_KEY=

# 위 지역 밖에서 쓰는 기존 MapLibre 지도 스타일. 비우면 OpenStreetMap 래스터를 사용.
VITE_MAP_STYLE_URL=
